{
  "name": "@akentros/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Portable Akentros core: pricing authority, USD billing (reserve/settle/refund), API keys, provider pools, inference pipeline and SSE — the behavior core of the self-hosted OpenAI-compatible Akentros AI gateway.",
  "license": "MIT",
  "keywords": [
    "ai-gateway",
    "openai-compatible",
    "llm",
    "api-gateway",
    "billing",
    "provider-pool",
    "sse",
    "api-keys",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrimordialSpirit-SANS/akentros.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/PrimordialSpirit-SANS/akentros/issues",
  "homepage": "https://github.com/PrimordialSpirit-SANS/akentros#readme",
  "engines": {
    "node": ">=20.19"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "config",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./apiKeys": "./src/apiKeys.ts",
    "./apiLimits": "./src/apiLimits.ts",
    "./billing": "./src/billing.ts",
    "./developerUsage": "./src/developerUsage.ts",
    "./inference": "./src/inference.ts",
    "./openaiErrors": "./src/openaiErrors.ts",
    "./pricing": "./src/pricing.ts",
    "./providerAttempts": "./src/providerAttempts.ts",
    "./providerPool": "./src/providerPool.ts",
    "./providers": "./src/providers.ts",
    "./query": "./src/query.ts",
    "./schemaMigration": "./src/schemaMigration.ts",
    "./schemaReadiness": "./src/schemaReadiness.ts",
    "./sse": "./src/sse.ts",
    "./validation": "./src/validation.ts",
    "./sqlDialect": "./src/sqlDialect.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "prepack": "npm run build",
    "stage": "node scripts/stage-publish.mjs",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "amaro": "^1.2.1"
  },
  "private": true
}
