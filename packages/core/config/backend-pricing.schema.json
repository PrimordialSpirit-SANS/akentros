{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akentros.example/schemas/akentros/backend-pricing.schema.json",
  "title": "Akentros backend pricing configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "published_at", "effective_at", "currency", "models"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "revision": { "$ref": "#/$defs/revision" },
    "published_at": { "type": "string", "format": "date-time" },
    "effective_at": { "type": "string", "format": "date-time" },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "token_scale"],
      "properties": {
        "unit": { "const": "point" },
        "token_scale": { "const": "1000000" }
      }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^akentros/[a-z0-9][a-z0-9._-]+$" },
      "additionalProperties": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "provider": {
      "enum": ["openrouter", "cloudflare-workers-ai", "hugging-face", "qwencloud"]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chat_completions", "streaming", "tools", "json_mode", "vision"],
      "properties": {
        "chat_completions": { "type": "boolean" },
        "streaming": { "type": "boolean" },
        "tools": { "type": "boolean" },
        "json_mode": { "type": "boolean" },
        "vision": { "type": "boolean" }
      }
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_points_per_million_tokens", "output_points_per_million_tokens", "minimum_points"],
      "properties": {
        "input_points_per_million_tokens": { "$ref": "#/$defs/decimal" },
        "output_points_per_million_tokens": { "$ref": "#/$defs/decimal" },
        "minimum_points": { "$ref": "#/$defs/decimal" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_tokens",
        "max_input_tokens",
        "default_max_completion_tokens",
        "max_completion_tokens"
      ],
      "properties": {
        "context_tokens": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "max_input_tokens": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "default_max_completion_tokens": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "max_completion_tokens": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "provider",
        "credential_pool",
        "upstream_model",
        "priority",
        "timeout_ms",
        "enabled"
      ],
      "properties": {
        "route_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$" },
        "provider": { "$ref": "#/$defs/provider" },
        "credential_pool": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$" },
        "upstream_model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "priority": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "enabled": { "type": "boolean" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object",
        "enabled",
        "display_name",
        "owned_by",
        "capabilities",
        "billing",
        "limits",
        "routes"
      ],
      "properties": {
        "object": { "const": "model" },
        "enabled": { "type": "boolean" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "owned_by": { "const": "akentros" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "billing": { "$ref": "#/$defs/billing" },
        "limits": { "$ref": "#/$defs/limits" },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/route" }
        }
      }
    }
  }
}
