{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Akentros gateway 的 Cloudflare Workers 部署設定:整個 Hono app 跑在
  // 單一 Durable Object(AkentrosGateway,SQLite-backed)內,Worker 本體只做
  // 轉發與 cron。Node 自架部署(nodeServer.ts)不使用本檔。
  "name": "akentros-gateway",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AKENTROS_DO",
        "class_name": "AkentrosGateway"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AkentrosGateway"]
    }
  ],
  // 對帳/清理:等價 Node 進入點的 in-process 維護迴圈(預設每 30 分鐘)。
  // Workers 上為固定 cron,AKENTROS_MAINTENANCE_INTERVAL_MS 不適用。
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "vars": {
    // fail-closed 開關:僅 true 時啟用 /api/ai/* 與 /api/auth/*。SN-15 fix:
    // 範本預設改為 "false",與自身註解(部署後先以 404 驗證路由存在性,
    // 煙霧測試通過後再打開)一致;先前預設 true 與註解自相矛盾。
    "AKENTROS_ENABLED": "false",
    // SN-15 fix:防濫用相關變數在範本中顯露出來(此前只存在於 .dev.vars.example,
    // 生產樣板反而比開發樣板鬆):
    //   AKENTROS_SIGNUP_BONUS_USD - 註冊贈點(預設 $5);對外開放註冊的部署
    //     應明確決定金額,設 0 可停用。
    //   AKENTROS_DISABLE_REGISTRATION=true - 完全關閉註冊(已種子的管理員不受影響)。
    "AKENTROS_SIGNUP_BONUS_USD": "0",
    "AKENTROS_DISABLE_REGISTRATION": "true",
    "RATE_LIMIT_NAMESPACE": "akentros",
    // 依實際 Pages 網域填:允許帶 cookie 的 console 來源(CSV)。
    "FRONTEND_ORIGINS": "http://localhost:5173",
    "FRONTEND_BASE_URL": "http://localhost:5173"
  }
  // Secrets 一律以 `wrangler secret put` 設定,不得寫進本檔:
  //   JWT_SECRET、AKENTROS_API_KEY_PEPPER(各 ≥32 bytes)
  //   ADMIN_EMAIL、ADMIN_PASSWORD(管理員種子;DO 首次啟動時套用)
  //   OPENROUTER_API_KEY_1 …(僅啟用的供應商,見 docs/PROVIDERS.md)
  // 資料庫為 DO 內建 SQLite,不需要 AKENTROS_DB_PATH。
}
