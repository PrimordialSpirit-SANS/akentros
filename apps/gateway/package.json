{
  "name": "@akentros/gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Akentros gateway: OpenAI-compatible API, key management and billing. Runs as a Node server (nodeServer.ts) or on Cloudflare Workers via a Durable Object (worker.ts).",
  "license": "MIT",
  "scripts": {
    "migrate": "node scripts/migrateAkentros.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "start": "node src/nodeServer.ts",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@akentros/core": "*",
    "dotenv": "^17.2.0",
    "hono": "^4.9.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.133.0"
  }
}
