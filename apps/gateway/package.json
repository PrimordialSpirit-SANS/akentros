{
  "name": "@beacon/gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Beacon gateway: OpenAI-compatible API, key management and billing. Runs as a Node server (nodeServer.ts) or on Cloudflare Workers via a Durable Object (worker.ts).",
  "license": "MIT",
  "scripts": {
    "migrate": "node scripts/migrateBeacon.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "start": "node src/nodeServer.ts",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@beacon/core": "*",
    "dotenv": "^17.2.0",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.40.0"
  }
}
